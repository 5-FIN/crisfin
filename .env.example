# ── Database ──────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/crisfin
DB_USERNAME=crisfin
DB_PASSWORD=crisfin

# ── JWT ───────────────────────────────────────
JWT_SECRET=crisfin-dev-secret-key-must-be-at-least-256-bits-long-for-hs256-testing

# ── AI API Keys ───────────────────────────────
# 실제 LLM: GEMINI_API_KEY 설정 후 spring.profiles.active=dev 로 실행
# API key 없이 개발: spring.profiles.active=local-mock 로 실행 (Mock 응답)
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# ── Public Data ───────────────────────────────
PUBLIC_DATA_API_KEY=

# ── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
