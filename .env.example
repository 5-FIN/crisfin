# ── Database ──────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/crisfin
DB_USERNAME=crisfin
DB_PASSWORD=crisfin

# ── JWT ───────────────────────────────────────
JWT_SECRET=crisfin-dev-secret-key-must-be-at-least-256-bits-long-for-hs256-testing

# ── AI API Keys ───────────────────────────────
# 실제 LLM: 키 1개 이상 설정 후 기본 프로파일(또는 -Dspring.profiles.active=local)로 실행
# Mock(키 없이 개발): spring.profiles.active=local-mock 로 실행 (Mock 응답)
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
# 사용할 LLM 우선순위(쉼표). 미설정 시 기본 GEMINI,CLAUDE,OPENAI.
# OPENAI 키만 있으면 아래 주석을 풀어 폴백 실패 호출을 줄이세요.
# LLM_PROVIDERS_ORDER=OPENAI

# ── Public Data ───────────────────────────────
PUBLIC_DATA_API_KEY=

# ── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
